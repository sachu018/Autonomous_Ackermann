[Unit]
Description=RTK-Only Closed-Loop UGV Controller Service
After=network.target

[Service]
Type=simple
User=debian
WorkingDirectory=/home/debian/Robot/UGV_closed
ExecStart=/bin/bash /home/debian/Robot/UGV_closed/startup.sh
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
