                <div class="telemetry-card">
                    <span class="card-label">Wheel Encoders (RPM)</span>
                    <div class="card-value-row">
                        <span class="card-value" style="color: #10b981;" id="enc-l-r">L: +0.0 / R: +0.0</span>
                    </div>
                    <div class="axis-row">
                        <div class="axis-item x" style="border-left-color: #10b981;">
                            <span class="axis-name">Left RPM</span>
                            <span class="axis-val" id="enc-l-val">+0.0</span>
                        </div>
                        <div class="axis-item y" style="border-left-color: #3b82f6;">
                            <span class="axis-name">Right RPM</span>
                            <span class="axis-val" id="enc-r-val">+0.0</span>
                        </div>
                    </div>
                </div>

                <div class="telemetry-card">
                    <span class="card-label">FlySky Transmitter</span>
                    <div class="card-value-row">
                        <span class="card-value" style="color: #eab308;" id="flysky-state">STANDBY</span>
                    </div>
                    <div class="axis-row">
                        <div class="axis-item x" style="border-left-color: #ef4444;">
                            <span class="axis-name">Stick X</span>
